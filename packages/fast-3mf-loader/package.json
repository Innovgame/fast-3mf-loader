{
    "name": "@innovgame/fast-3mf-loader",
    "version": "0.0.8",
    "type": "module",
    "description": "Browser-first TypeScript parser and Three.js builder for 3MF archives",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "rekor <innovgamejs@163.com>",
    "files": [
        "dist",
        "README.md"
    ],
    "keywords": [
        "xml",
        "3mf",
        "three",
        "typescript",
        "parser"
    ],
    "main": "./dist/fast-3mf-loader.umd.cjs",
    "module": "./dist/fast-3mf-loader.js",
    "types": "./dist/lib/main.d.ts",
    "exports": {
        ".": {
            "types": "./dist/lib/main.d.ts",
            "import": "./dist/fast-3mf-loader.js",
            "require": "./dist/fast-3mf-loader.umd.cjs"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.lib.json && vite build",
        "check:lib": "tsc -p tsconfig.lib.json --noEmit",
        "check:test": "tsc -p tsconfig.test.json --noEmit",
        "test": "vitest run",
        "benchmark": "node scripts/benchmark.mjs",
        "benchmark:release": "FAST3MF_BENCHMARK_WARMUP_RUNS=2 FAST3MF_BENCHMARK_MEASURED_RUNS=7 FAST3MF_BENCHMARK_WORKERS=6 pnpm benchmark",
        "pack:check": "pnpm pack --dry-run"
    },
    "peerDependencies": {
        "three": ">=0.170.0"
    },
    "dependencies": {
        "easysax": "^0.6.1",
        "fflate": "^0.8.3"
    },
    "devDependencies": {
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/three": "^0.186.0",
        "jsdom": "^30.1.2",
        "three": "^0.186.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.4"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Innovgame/fast-3mf-loader.git",
        "directory": "packages/fast-3mf-loader"
    },
    "bugs": {
        "url": "https://github.com/Innovgame/fast-3mf-loader/issues"
    },
    "homepage": "https://innovgame.github.io/fast-3mf-loader/"
}
