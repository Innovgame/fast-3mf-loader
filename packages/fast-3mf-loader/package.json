{
    "name": "@innovgame/fast-3mf-loader",
    "version": "0.0.8",
    "type": "module",
    "description": "Browser-first TypeScript parser and Three.js builder for 3MF archives",
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    },
    "author": "rekor <innovgamejs@163.com>",
    "sideEffects": false,
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "keywords": [
        "xml",
        "3mf",
        "three",
        "typescript",
        "parser"
    ],
    "main": "./dist/index.umd.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "unpkg": "./dist/index.umd.cjs",
    "jsdelivr": "./dist/index.umd.cjs",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.umd.cjs"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc -p tsconfig.lib.json && vite build",
        "check:lib": "tsc -p tsconfig.lib.json --noEmit",
        "check:test": "tsc -p tsconfig.test.json --noEmit",
        "test": "vitest run",
        "benchmark": "node scripts/benchmark.mjs",
        "benchmark:release": "node scripts/benchmark-release.mjs",
        "pack:check": "npm pack --dry-run"
    },
    "peerDependencies": {
        "three": ">=0.170.0"
    },
    "dependencies": {
        "easysax": "^0.6.1",
        "fflate": "^0.8.3"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.59.4",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.5",
        "@types/three": "^0.186.0",
        "jsdom": "^30.1.2",
        "three": "^0.186.1",
        "typescript": "^6.0.3",
        "vite": "^8.3.4",
        "vite-plugin-dts": "^5.1.2",
        "vitest": "^5.0.4"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Innovgame/fast-3mf-loader.git",
        "directory": "packages/fast-3mf-loader"
    },
    "bugs": {
        "url": "https://github.com/Innovgame/fast-3mf-loader/issues"
    },
    "homepage": "https://innovgame.github.io/fast-3mf-loader/"
}
